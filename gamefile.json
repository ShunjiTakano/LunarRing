{
  "name": "Lunar Ring",
  "scriptsUrls": [
    "https://shunjitakano.github.io/LunarRing/functions.jsx",
    "https://shunjitakano.github.io/LunarRing/resolve.js"
  ],
  "deckBuilding": {
    "mainFilters": [
      "type",
      "cost",
      "covenant"
    ],
    "costCurveIgnoredTypes": [
      "Devotee",
      "Presence",
      "Token Withdrawal",
      "Token Edict",
      "Token Acolyte",
      "Token Weapon"
    ],
    "formats": [
      {
        "title": "Standard",
        "customCategories": [
          "Devotee",
          "Presence"
        ],
        "legalityCode": "STD",
        "gameplay": "Standard",
        "deckRuleset": "Standard"
      }
    ],
    "deckRulesets": {
      "Standard": {
        "checkCardLegality": true,
        "general": {
          "min": 40,
          "max": 40,
          "maxPerCard": 3
        },
        "categories": [
          {
            "category": "Devotee",
            "min": 3,
            "max": 3,
            "ignoreTotalCount": true
          },
          {
            "category": "Presence",
            "min": 3,
            "max": 3,
            "ignoreTotalCount": true
          }
        ]
      }
    }
  },
  "gameplay": {
    "Standard": {
      "defaultNotes": "Set your Health/Resolve counters above to match your chosen Devotee's printed stats (Counter 1 = Health, Counter 2 = Resolve).\nHazed Memories (opponent): 0",
      "countersStartingValues": [0, 0],
      "mulligan": {
        "startingHandSize": 5,
        "mulliganCount": {
          "max": 1
        },
        "mulliganCycle": {
          "info": "Return any number of cards to the bottom of your deck, then draw that many.",
          "steps": [
            "toBottom",
            "draw"
          ],
          "selectionRange": {
            "min": 0,
            "max": 5
          }
        }
      },
      "newTurn": {
        "drawOnStart": false,
        "drawPerTurn": 1
      },
      "draggableTokens": [
        {
          "id": "Damage",
          "name": "Damage",
          "image": "https://shunjitakano.github.io/LunarRing/images/tokens/damage.webp"
        }
      ],
      "sections": {
        "layout": {
          "direction": "column",
          "content": [
            {
              "direction": "row",
              "content": [
                {
                  "section": "Devotee",
                  "style": {
                    "width": "15vh"
                  }
                },
                {
                  "section": "Presence",
                  "style": {
                    "width": "15vh"
                  }
                },
                {
                  "section": "ResolveHelper",
                  "style": {
                    "width": "15vh"
                  }
                }
              ]
            },
            {
              "section": "Armoury"
            },
            {
              "direction": "row",
              "style": {
                "marginLeft": "18vh"
              },
              "content": [
                {
                  "section": "Deck",
                  "style": {
                    "width": "16%"
                  }
                },
                {
                  "section": "Hand",
                  "style": {
                    "width": "60%"
                  }
                },
                {
                  "section": "Discard",
                  "style": {
                    "width": "16%"
                  }
                }
              ]
            }
          ]
        },
        "categoriesAlreadyOnBoard": [
          "Devotee->Devotee",
          "Presence->Presence"
        ],
        "sharedZone": {
          "height": 12,
          "layout": {
            "direction": "column",
            "content": [
              {
                "section": "ActivePresences"
              }
            ]
          }
        },
        "sectionsDict": {
          "Devotee": {
            "isHidden": "no",
            "height": 10,
            "alignment": "START",
            "isHorizontalAllowed": true
          },
          "Presence": {
            "isHidden": "no",
            "height": 10,
            "alignment": "START",
            "isHorizontalAllowed": true,
            "displayedTitle": "Presences (unplayed)"
          },
          "ResolveHelper": {
            "type": "custom",
            "height": 10,
            "defaultValue": { "max": 0, "current": 0, "started": false, "enforce": true },
            "blueprint": {
              "type": "div",
              "children": [
                { "type": "div", "children": "Resolve max: {{ game.data.ResolveHelper.max }}" },
                { "type": "div", "children": "Resolve:" },
                {
                  "type": "input-number",
                  "props": { "value": "{{ game.data.ResolveHelper.current }}" },
                  "onChange": "await setResolve(Number(value))"
                },
                { "type": "button", "children": "Refill resolve", "onClick": "await refillResolve()" },
                {
                  "type": "button",
                  "children": "{{ game.data.ResolveHelper.enforce ? 'Resolve check: ON' : 'Resolve check: OFF' }}",
                  "onClick": "game.data.ResolveHelper.enforce = !game.data.ResolveHelper.enforce"
                }
              ]
            },
            "events": {
              "onPlayersReady": "game.data.ResolveHelper.started = true",
              "onNewTurn": "await onMyNewTurn()"
            }
          },
          "ActivePresences": {
            "isHidden": "no",
            "height": 12,
            "alignment": "CENTER",
            "displayedTitle": "Active Presences"
          },
          "Armoury": {
            "isHidden": "no",
            "height": 13,
            "alignment": "CENTER",
            "isHorizontalAllowed": true,
            "displayedTitle": "Armoury"
          },
          "Discard": {
            "isHidden": "no",
            "height": 15,
            "alignment": "DECK",
            "displayedTitle": "Scrapyard"
          },
          "Hand": {
            "isHidden": "opponent-only",
            "height": 15,
            "alignment": "CENTER",
            "isHorizontalAllowed": true,
            "events": {
              "onCardsLeave": "await onCardsLeftHand(transitionCards)"
            }
          }
        },
        "autoPlayFromHand": {
          "Acolyte": "Armoury",
          "Weapon": "Armoury",
          "Edict": "Armoury",
          "Tactic": "Discard",
          "Riposte": "Discard"
        },
        "autoPlayFromStack": {
          "Acolyte": "Armoury",
          "Weapon": "Armoury",
          "Edict": "Armoury",
          "Token Edict": "Armoury",
          "Token Acolyte": "Armoury",
          "Token Weapon": "Armoury",
          "Tactic": "Discard",
          "Riposte": "Discard",
          "Token Withdrawal": "Discard"
        }
      }
    }
  },
  "defaultRessources": {
    "decksUrl": "https://shunjitakano.github.io/LunarRing/decks.json"
  },
  "cards": {
    "dataUrl": "https://shunjitakano.github.io/LunarRing/cards.json",
    "cardBack": "https://shunjitakano.github.io/LunarRing/images/card-back.webp"
  },
  "customHelp": "House rule: your deck should use cards from a single covenant only (use the covenant filter when building). This isn't enforced automatically -- it's on you and your opponent to keep decks mono-covenant. At game start, all 3 of your Devotee condition cards (Thriving/Wounded/Desperate) and all 3 Pale Stare Presences are placed directly on the board -- they are never part of your draw deck. When your health hits 0, discard your current Devotee condition card and treat the next one (Wounded, then Desperate) as active. Every 3 rounds The Pale Stare advances a phase (Dormant -> Crescent Moon -> Half Moon -> Full Moon -> Eclipse); whichever player has the most health when it advances activates their matching Presence -- track this manually for now, and drag the activated Presence from your 'Presences (unplayed)' area into the shared 'Active Presences' zone."
}