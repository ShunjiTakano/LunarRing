{
  "name": "Lunar Ring",
  "scriptsUrls": ["https://shunjitakano.github.io/LunarRing/functions.jsx"],

  "deckBuilding": {
    "mainFilters": ["type", "cost", "covenant"],
    "costCurveIgnoredTypes": ["Devotee", "Presence", "Token Withdrawal", "Token Item", "Token Edict", "Token Acolyte", "Token Weapon"],
    "formats": [
      { "title": "Igon Standard",    "customCategories": ["Devotee", "Presence"], "legalityCode": "IGO", "gameplay": "Standard", "deckRuleset": "Standard" },
      { "title": "Yandari Standard", "customCategories": ["Devotee", "Presence"], "legalityCode": "YAN", "gameplay": "Standard", "deckRuleset": "Standard" },
      { "title": "Kuran Standard",   "customCategories": ["Devotee", "Presence"], "legalityCode": "KUR", "gameplay": "Standard", "deckRuleset": "Standard" },
      { "title": "Niorr Standard",   "customCategories": ["Devotee", "Presence"], "legalityCode": "NIO", "gameplay": "Standard", "deckRuleset": "Standard" },
      { "title": "Qirune Standard",  "customCategories": ["Devotee", "Presence"], "legalityCode": "QIR", "gameplay": "Standard", "deckRuleset": "Standard" },
      { "title": "Xurdos Standard",  "customCategories": ["Devotee", "Presence"], "legalityCode": "XUR", "gameplay": "Standard", "deckRuleset": "Standard" }
    ],
    "deckRulesets": {
      "Standard": {
        "checkCardLegality": true,
        "general": { "min": 40, "max": 40, "maxPerCard": 3 },
        "categories": [
          { "category": "Devotee",  "min": 3, "max": 3 },
          { "category": "Presence", "min": 3, "max": 3 }
        ]
      }
    }
  },

  "gameplay": {
    "Standard": {
      "defaultNotes": "Hazed Memories (opponent): 0",
      "countersStartingValues": [],

      "mulligan": {
        "startingHandSize": 5,
        "mulliganCount": { "max": 1 },
        "mulliganCycle": {
          "info": "Return any number of cards to the bottom of your deck, then draw that many.",
          "steps": ["toBottom", "draw"],
          "selectionRange": { "min": 0, "max": 5 }
        }
      },

      "newTurn": {
        "drawOnStart": false,
        "drawPerTurn": 1
      },

      "draggableTokens": [
        { "id": "Damage", "name": "Damage", "image": "https://shunjitakano.github.io/LunarRing/images/tokens/damage.webp" }
      ],

      "sections": {
        "layout": {
          "direction": "column",
          "content": [
            {
              "direction": "row",
              "content": [
                { "section": "Devotee", "style": { "width": "15vh" } },
                { "section": "Presence", "style": { "width": "15vh" } },
                { "section": "Vitals", "style": { "width": "12vh" } }
              ]
            },
            { "section": "Armoury" },
            {
              "direction": "row",
              "content": [
                { "section": "Discard", "style": { "width": "20%" } },
                { "section": "Deck", "style": { "width": "20%" } },
                { "section": "Hand", "style": { "width": "60%" } }
              ]
            }
          ]
        },

        "categoriesAlreadyOnBoard": ["Devotee", "Presence"],

        "sharedZone": {
          "height": 16,
          "layout": {
            "direction": "column",
            "content": [{ "section": "Stack" }]
          }
        },

        "sectionsDict": {
          "Devotee": {
            "isHidden": "no",
            "height": "SMALL",
            "alignment": "START",
            "isHorizontalAllowed": true
          },
          "Presence": {
            "isHidden": "no",
            "height": "SMALL",
            "alignment": "START",
            "isHorizontalAllowed": true
          },
          "Vitals": {
            "type": "custom",
            "defaultValue": { "health": 0, "resolve": 0, "initialized": false },
            "blueprint": {
              "type": "div",
              "props": {
                "style": {
                  "width": "12vh",
                  "padding": "0.4rem",
                  "borderRadius": "0.5vh",
                  "backgroundColor": "#18293dcc"
                },
                "className": "d-flex flex-column gap-1"
              },
              "children": [
                {
                  "type": "div",
                  "props": { "className": "d-flex justify-content-between align-items-center" },
                  "children": [
                    { "type": "span", "props": { "style": { "color": "#c04040" } }, "children": "Health" },
                    {
                      "type": "input-number",
                      "props": {
                        "value": "{{ game.data.Vitals.health }}",
                        "style": { "width": "6vh", "--input-background-color": "#18293d57" }
                      },
                      "onChange": "game.data.Vitals.health = value; chatLog('Health is now ' + value)"
                    }
                  ]
                },
                {
                  "type": "div",
                  "props": { "className": "d-flex justify-content-between align-items-center" },
                  "children": [
                    { "type": "span", "props": { "style": { "color": "#c48f21" } }, "children": "Resolve" },
                    {
                      "type": "input-number",
                      "props": {
                        "value": "{{ game.data.Vitals.resolve }}",
                        "style": { "width": "6vh", "--input-background-color": "#18293d57" }
                      },
                      "onChange": "game.data.Vitals.resolve = value; chatLog('Resolve is now ' + value)"
                    }
                  ]
                }
              ]
            },
            "events": {}
          },
          "Armoury": {
            "isHidden": "no",
            "height": 18,
            "alignment": "START",
            "isHorizontalAllowed": true,
            "displayedTitle": "Armoury"
          },
          "Discard": {
            "isHidden": "no",
            "height": "SMALL",
            "alignment": "DECK",
            "displayedTitle": "Scrapyard"
          },
          "Stack": {
            "isHidden": "no",
            "height": "MEDIUM",
            "alignment": "CENTER",
            "displayedTitle": "The Fracture"
          }
        },

        "autoPlayFromHand": {
          "Acolyte": "Stack",
          "Weapon": "Stack",
          "1-Handed Weapon": "Stack",
          "2-Handed Weapon": "Stack",
          "Edict": "Stack",
          "Item": "Stack",
          "Tome": "Stack",
          "Ability": "Stack",
          "Concoction": "Stack",
          "Tactic": "Stack",
          "Riposte": "Stack",
          "Act of Desperation": "Stack",
          "Act of Desperation: Tome": "Stack",
          "Act of Desperation: Eternal": "Stack"
        },

        "autoPlayFromStack": {
          "Acolyte": "Armoury",
          "Weapon": "Armoury",
          "1-Handed Weapon": "Armoury",
          "2-Handed Weapon": "Armoury",
          "Edict": "Armoury",
          "Item": "Armoury",
          "Tome": "Armoury",
          "Ability": "Armoury",
          "Token Edict": "Armoury",
          "Token Acolyte": "Armoury",
          "Token Weapon": "Armoury",
          "Token Item": "Armoury",
          "Tactic": "Discard",
          "Riposte": "Discard",
          "Concoction": "Discard",
          "Act of Desperation": "Discard",
          "Act of Desperation: Tome": "Discard",
          "Act of Desperation: Eternal": "Discard",
          "Token Withdrawal": "Discard"
        }
      }
    }
  },

  "cards": {
    "dataUrl": "https://shunjitakano.github.io/LunarRing/cards.json",
    "cardBack": "https://shunjitakano.github.io/LunarRing/images/card-back.webp"
  },

  "customHelp": "At game start, all 3 of your Devotee condition cards (Thriving/Wounded/Desperate) and all 3 Pale Stare Presences are placed directly on the board -- they are never part of your draw deck. When your health hits 0, discard your current Devotee condition card and treat the next one (Wounded, then Desperate) as active. Every 3 rounds The Pale Stare advances a phase (Dormant -> Crescent Moon -> Half Moon -> Full Moon -> Eclipse); whichever player has the most health when it advances activates their matching Presence -- track this manually for now."
}