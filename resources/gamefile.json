{
  "name": "Lunar Ring",

  "deckBuilding": {
    "mainFilters": ["type", "cost", "covenant"],
    "costCurveIgnoredTypes": ["Devotee", "Presence", "Token Withdrawal", "Token Item", "Token Edict", "Token Acolyte", "Token Weapon"],
    "formats": [
      { "title": "Igon Standard",    "customCategories": ["Devotee", "Presence"], "legalityCode": "IGO", "gameplay": "Standard", "deckRuleset": "Standard" },
      { "title": "Yandari Standard", "customCategories": ["Devotee", "Presence"], "legalityCode": "YAN", "gameplay": "Standard", "deckRuleset": "Standard" },
      { "title": "Kuran Standard",   "customCategories": ["Devotee", "Presence"], "legalityCode": "KUR", "gameplay": "Standard", "deckRuleset": "Standard" },
      { "title": "Niorr Standard",   "customCategories": ["Devotee", "Presence"], "legalityCode": "NIO", "gameplay": "Standard", "deckRuleset": "Standard" },
      { "title": "Qirune Standard",  "customCategories": ["Devotee", "Presence"], "legalityCode": "QIR", "gameplay": "Standard", "deckRuleset": "Standard" },
      { "title": "Xurdos Standard",  "customCategories": ["Devotee", "Presence"], "legalityCode": "XUR", "gameplay": "Standard", "deckRuleset": "Standard" }
    ],
    "deckRulesets": {
      "Standard": {
        "checkCardLegality": true,
        "general": { "min": 40, "max": 40, "maxPerCard": 3 },
        "categories": [
          { "category": "Devotee",  "min": 3, "max": 3 },
          { "category": "Presence", "min": 3, "max": 3 }
        ]
      }
    }
  },

  "gameplay": {
    "Standard": {
      "defaultNotes": "Set Health/Resolve counters above to match your chosen Devotee's printed stats.\nHazed Memories (opponent): 0",
      "countersStartingValues": [10, 3],

      "mulligan": {
        "startingHandSize": 5,
        "mulliganCount": { "max": 1 },
        "mulliganCycle": {
          "info": "Return any number of cards to the bottom of your deck, then draw that many.",
          "steps": ["toBottom", "draw"],
          "selectionRange": { "min": 0, "max": 5 }
        }
      },

      "newTurn": {
        "drawOnStart": false,
        "drawPerTurn": 1
      },

      "draggableTokens": [
        { "id": "Damage", "name": "Damage", "image": "https://shunjitakano.github.io/LunarRing/images/tokens/damage.webp" }
      ],

      "beforeGameStart": {
        "categoriesAlreadyOnBoard": ["Devotee->DevoteeReserve", "Presence->PresenceDisplay"]
      },

      "sections": {
        "layout": {
          "direction": "column",
          "content": [
            {
              "direction": "row",
              "content": [
                { "section": "DevoteeReserve", "style": { "width": "18%" } },
                { "section": "DevoteeActive", "style": { "width": "14%" } },
                { "section": "PresenceDisplay", "style": { "width": "22%" } }
              ]
            },
            { "section": "Armoury" },
            {
              "direction": "row",
              "content": [
                { "section": "Discard", "style": { "width": "20%" } },
                { "section": "Deck", "style": { "width": "20%" } },
                { "section": "Hand", "style": { "width": "60%" } }
              ]
            }
          ]
        },

        "sharedZone": {
          "height": 16,
          "layout": {
            "direction": "column",
            "content": [{ "section": "Stack" }]
          }
        },

        "sectionsDict": {
          "DevoteeReserve": {
            "isHidden": "opponent-only",
            "height": "SMALL",
            "alignment": "NONE",
            "displayedTitle": "Devotee Conditions"
          },
          "DevoteeActive": {
            "isHidden": "no",
            "height": "SMALL",
            "alignment": "CENTER",
            "displayedTitle": "Active Devotee"
          },
          "PresenceDisplay": {
            "isHidden": "no",
            "height": "SMALL",
            "alignment": "CENTER",
            "displayedTitle": "Pale Stare Presences"
          },
          "Armoury": {
            "isHidden": "no",
            "height": 30,
            "alignment": "START",
            "isHorizontalAllowed": true,
            "displayedTitle": "Armoury"
          },
          "Discard": {
            "isHidden": "no",
            "height": "SMALL",
            "alignment": "DECK",
            "displayedTitle": "Scrapyard"
          },
          "Stack": {
            "isHidden": "no",
            "height": "MEDIUM",
            "alignment": "CENTER",
            "displayedTitle": "The Fracture"
          }
        },

        "autoPlayFromHand": {
          "Acolyte": "Stack",
          "Weapon": "Stack",
          "1-Handed Weapon": "Stack",
          "2-Handed Weapon": "Stack",
          "Edict": "Stack",
          "Item": "Stack",
          "Tome": "Stack",
          "Ability": "Stack",
          "Concoction": "Stack",
          "Tactic": "Stack",
          "Riposte": "Stack",
          "Act of Desperation": "Stack",
          "Act of Desperation: Tome": "Stack",
          "Act of Desperation: Eternal": "Stack"
        },

        "autoPlayFromStack": {
          "Acolyte": "Armoury",
          "Weapon": "Armoury",
          "1-Handed Weapon": "Armoury",
          "2-Handed Weapon": "Armoury",
          "Edict": "Armoury",
          "Item": "Armoury",
          "Tome": "Armoury",
          "Ability": "Armoury",
          "Token Edict": "Armoury",
          "Token Acolyte": "Armoury",
          "Token Weapon": "Armoury",
          "Token Item": "Armoury",
          "Tactic": "Discard",
          "Riposte": "Discard",
          "Concoction": "Discard",
          "Act of Desperation": "Discard",
          "Act of Desperation: Tome": "Discard",
          "Act of Desperation: Eternal": "Discard",
          "Token Withdrawal": "Discard"
        }
      }
    }
  },

  "cards": {
    "dataUrl": "https://shunjitakano.github.io/LunarRing/resources/cards.json",
    "cardBack": "https://shunjitakano.github.io/LunarRing/images/card-back.jpg"
  },

  "customHelp": "At game start: drag your Thriving Devotee card from 'Devotee Conditions' into 'Active Devotee', and set your Health/Resolve counters to match its printed stats. When your health hits 0, discard the old condition and move the next one (Wounded, then Desperate) into Active Devotee. Every 3 rounds The Pale Stare advances a phase (Dormant -> Crescent Moon -> Half Moon -> Full Moon -> Eclipse); whichever player has the most health when it advances activates their matching Presence -- track this manually for now."
}